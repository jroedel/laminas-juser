<?php
/**
 * A valid sign-in link for an account an administrator has deactivated.
 *
 * Deliberately not the verify-failed page. That one says "links expire and can only be
 * used once" and offers a new one, which for a deactivated account is an invitation to
 * try forever. This says what is actually true and names the only thing that fixes it.
 *
 * No "send me a new link" button here for the same reason.
 *
 * @var \Laminas\View\Renderer\PhpRenderer $this
 */
$title = $this->translate('This account has been deactivated');
$this->headTitle($title);
?>
<h1><?php echo $this->escapeHtml($title); ?></h1>

<p><?php echo $this->escapeHtml($this->translate(
    'Your sign-in link was valid, but access to this account has been turned off, '
    . 'so we could not sign you in. If you think that is a mistake, please contact '
    . 'whoever administers the site.'
)); ?></p>
