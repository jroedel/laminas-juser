<?php
/** @var \Laminas\View\Renderer\PhpRenderer $this */
$title = $this->translate('Check your email');
$this->headTitle($title);
$minutes = (int) $this->expirationMinutes;
?>
<h1><?php echo $this->escapeHtml($title); ?></h1>

<p><?php echo $this->escapeHtml(sprintf(
    $this->translate('If that address is valid, we sent you a sign-in link. It expires in %s minutes.'),
    $minutes
)); ?></p>

<p class="help-block"><?php echo $this->escapeHtml($this->translate(
    'Nothing in your inbox after a minute or two? Check the spam folder.'
)); ?></p>

<p><a href="<?php echo $this->url('zfcuser/login'); ?>"><?php echo $this->escapeHtml(
    $this->translate('Use a different address')
); ?></a></p>
