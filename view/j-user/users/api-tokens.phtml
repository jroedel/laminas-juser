<?php
$title = 'API Tokens';
$this->headTitle($title);
$displayName = $user['displayName'] ?: ($user['username'] ?: $user['email']);
?>
<h1><?php echo $this->escapeHtml($this->translate($title)); ?></h1>
<p>
    <?php echo $this->translate("Account"); ?>:
    <strong><?php echo $this->escapeHtml($displayName); ?></strong>
    (<?php echo $this->escapeHtml($user['email']); ?>)
    &nbsp;|&nbsp;
    <a href="<?php echo $this->url('juser'); ?>"><?php echo $this->translate("Back to user management"); ?></a>
</p>

<?php if ($mayIssue) : ?>
<div class="panel panel-default">
    <div class="panel-heading"><?php echo $this->translate("Issue a new token"); ?></div>
    <div class="panel-body">
        <p class="text-muted">
            <?php echo sprintf(
                $this->translate("A new token lasts %d days. It is shown once and never stored — "
                    . "we keep only its identifier, so it can be revoked but never recovered."),
                $lifetimeDays
            ); ?>
        </p>
        <?php
        $form->setAttribute('action', $this->url('juser/user/api-tokens', ['user_id' => $userId]));
        $form->prepare();
        echo $this->form()->openTag($form);
        echo $this->formRow($form->get('label'));
        echo $this->formRow($form->get('security'));
        echo $this->formSubmit($form->get('issue'));
        echo $this->form()->closeTag();
        ?>
    </div>
</div>
<?php else : ?>
<div class="alert alert-info">
    <?php if (empty($issuableRoles)) : ?>
        <?php echo $this->translate(
            "No role is configured as eligible for API tokens, so none can be issued here. "
            . "Set juser.api_token_roles in the application config."
        ); ?>
    <?php else : ?>
        <?php echo sprintf(
            $this->translate("This account holds none of the roles eligible for an API token (%s), "
                . "so no token can be issued for it. Grant the role first if that is what you intend."),
            $this->escapeHtml(implode(', ', $issuableRoles))
        ); ?>
    <?php endif; ?>
</div>
<?php endif; ?>

<h2><?php echo $this->translate("Tokens on record"); ?></h2>
<?php if (empty($tokens)) : ?>
<p><?php echo $this->translate("None. Nothing has ever been issued for this account."); ?></p>
<?php else : ?>
<table class="table">
<tr>
    <th><?php echo $this->translate("Label"); ?></th>
    <th><?php echo $this->translate("Status"); ?></th>
    <th><?php echo $this->translate("Issued"); ?></th>
    <th><?php echo $this->translate("Expires"); ?></th>
    <th><?php echo $this->translate("Identifier"); ?></th>
    <th></th>
</tr>
<?php foreach ($tokens as $token) : ?>
<tr<?php echo $token['isLive'] ? '' : ' class="text-muted"'; ?>>
    <td><?php echo $this->escapeHtml($token['label'] ?: '—'); ?></td>
    <td><?php
    if (null !== $token['revokedOn']) {
        echo '<span class="label label-danger">' . $this->translate("revoked") . '</span> '
            . $this->escapeHtml($token['revokedOn']->format('Y-m-d'));
    } elseif (! $token['isLive']) {
        echo '<span class="label label-default">' . $this->translate("expired") . '</span>';
    } else {
        echo '<span class="label label-success">' . $this->translate("live") . '</span>';
    }
    ?></td>
    <td><?php
    echo $token['issuedOn'] instanceof DateTime ? $this->escapeHtml($token['issuedOn']->format('Y-m-d H:i')) : '';
    //A NULL issued_by is the account signing itself in by email, which is a
    //different provenance from an admin pressing the button, not missing data.
    echo null === $token['issuedBy']
        ? ' <small class="text-muted">' . $this->translate("(self, by email)") . '</small>'
        : ' <small class="text-muted">' . sprintf($this->translate("(by user %d)"), $token['issuedBy']) . '</small>';
    ?></td>
    <td><?php
    echo $token['expiresOn'] instanceof DateTime ? $this->escapeHtml($token['expiresOn']->format('Y-m-d')) : '';
    ?></td>
    <td><code><?php
    //The jti, not the token. Enough to match a row here against a log line,
    //useless as a credential.
    echo $this->escapeHtml(substr($token['jti'], 0, 8)); ?>…</code></td>
    <td><?php if ($token['isLive']) :
        $revokeForm->setAttribute('action', $this->url(
            'juser/user/api-token-revoke',
            ['user_id' => $userId, 'token_id' => $token['tokenId']]
        ));
        $revokeForm->prepare();
        echo $this->form()->openTag($revokeForm);
        echo $this->formRow($revokeForm->get('security'));
        echo $this->formSubmit($revokeForm->get('revoke'));
        echo $this->form()->closeTag();
    endif; ?></td>
</tr>
<?php endforeach; ?>
</table>
<p class="text-muted"><small><?php echo $this->translate(
    "Revoking takes effect on the token's next request. Expired tokens are cleared from this "
    . "list a day after they lapse; revoked ones are kept as a record."
); ?></small></p>
<?php endif; ?>
