{
    "name": "jroedel/laminas-juser",
    "description": "Passwordless (magic-link) user module. A Laminas MVC module in 2.x; Symfony-oriented in 3.x.",
    "license": "MIT",
    "keywords": [
        "authentication",
        "passwordless",
        "magic-link",
        "laminas"
    ],
    "homepage": "https://github.com/jroedel/laminas-juser",
    "require": {
        "php": "^8.2",
        "firebase/php-jwt": "^7.0",
        "jroedel/laminas-jtranslate": "dev-modernization",
        "jroedel/zf2-sion-model": "dev-master",
        "kokspflanze/bjy-authorize": "dev-master",
        "laminas/laminas-authentication": "^2.13",
        "laminas/laminas-cache": "^3.0 || ^4.0",
        "laminas/laminas-db": "^2.4.0",
        "laminas/laminas-eventmanager": "^3.11",
        "laminas/laminas-filter": "^2.34",
        "laminas/laminas-form": "^2.4.0",
        "laminas/laminas-http": "^2.19",
        "laminas/laminas-i18n": "^2.26",
        "laminas/laminas-inputfilter": "^2.30",
        "laminas/laminas-math": "^2.7 || ^3.0",
        "laminas/laminas-mvc": "^3.8",
        "laminas/laminas-mvc-plugin-flashmessenger": "^1.10",
        "laminas/laminas-permissions-acl": "^2.16",
        "laminas/laminas-router": "^3.13",
        "laminas/laminas-servicemanager": "^3.22",
        "laminas/laminas-session": "^2.20",
        "laminas/laminas-validator": "^2.64",
        "laminas/laminas-view": "^2.34",
        "psr/log": "^3.0",
        "symfony/mailer": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "JUser\\": "src/"
        }
    },
    "repositories": [
        {
            "type": "vcs",
            "url": "https://github.com/jroedel/laminas-jtranslate"
        },
        {
            "type": "vcs",
            "url": "https://github.com/jroedel/laminas-sion-model"
        },
        {
            "type": "vcs",
            "url": "https://github.com/kokspflanze/BjyAuthorize"
        }
    ]
}
