{
    "name": "jroedel/zf3-juser",
    "description": "Passwordless (magic-link) user module for Laminas MVC; integrates with BjyAuthorize and SlmLocale",
    "license": "MIT",
    "keywords": [
        "framework",
        "zf3"
    ],
    "homepage": "https://github.com/jroedel/zf3-juser",
    "require": {
        "php": "^5.6 || ^7.0",
        "laminas/laminas-db": "^2.4.0",
        "laminas/laminas-mvc-form": "^1.0",
        "laminas/laminas-form": "^2.4.0",
        "laminas/laminas-crypt": "^2.4.0 || ^3.1.0",
        "laminas/laminas-math": "^2.7 || ^3.0",
        "kokspflanze/bjy-authorize": "dev-master",
        "jroedel/locale": "dev-master@dev",
        "beaucal/beaucal-invalid-session": "^0.3.0",
        "swiftmailer/swiftmailer": "^6.0",
        "jroedel/zf2-sion-model": "dev-master"
    },
	"autoload": {
    	"psr-4": {
        	"JUser\\": "module/JUser/src/"
    	}
	},
	"repositories": [
	   {
	     "type": "vcs",
	     "url": "https://github.com/basz/SlmLocale"
	   },
	   {
	     "type": "vcs",
	     "url": "https://github.com/jroedel/zf3-sion-model"
	   },
	   {
	     "type": "vcs",
	     "url": "https://github.com/kokspflanze/BjyAuthorize"
	   }
	]
}
